{
	"name": "directus-extension-visual-flow-builder",
	"description": "Simplified visual flow builder with terminal, process, decision, and connector nodes",
	"icon": "account_tree",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "module",
				"name": "visual-flow-builder",
				"source": "src/module/index.ts"
			},
			{
				"type": "hook",
				"name": "visual-flow-builder-hook",
				"source": "src/hook/index.ts"
			}
		],
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "16.0.1",
		"typescript": "^5.9.2",
		"vue": "^3.5.20"
	},
	"dependencies": {
		"@directus/sdk": "^16.0.0",
		"@vue-flow/background": "^1.3.2",
		"@vue-flow/controls": "^1.1.3",
		"@vue-flow/core": "^1.46.0",
		"@vue-flow/minimap": "^1.5.4"
	}
}
